# Copie para `.env` e preencha. Nunca commitar o `.env`.
# Nao cole a chave no chat — o agente le este arquivo.
# Cole o token depois do =  (sem aspas, sem a palavra Bearer).

# API client do *seu* workspace Workato (Workspace admin → API clients).
# Sem chave, envie o arquivo .json da receita no chat.
WORKATO_API_KEY=

# Datacenter (so mude se a conta nao for US).
# WORKATO_API_BASE=https://www.workato.com/api
# WORKATO_API_BASE=https://app.eu.workato.com/api
